# TraceLens configuration template.
#     cp .env.example .env
#
# The LLM features (session summaries, and later the block classifier) use any
# OpenAI-compatible endpoint. With no key set the dashboard still works fully —
# sessions fall back to the title Claude Code writes itself.
#
# NOTE: a real environment variable exported in your shell wins over this file,
# and a blank value here never overrides anything.

# --- LLM provider (OpenAI, OpenRouter, a LiteLLM proxy, ...) ---

OPENAI_API_KEY=

# Endpoint. Leave unset for OpenAI itself; set it for a proxy / other provider.
# OPENAI_BASE_URL=https://your-endpoint/v1

# Model name your endpoint exposes (default: gpt-4o-mini).
# SPLIT_ADVISOR_MODEL is also honoured, so an existing Local_app .env works.
# TRACELENS_MODEL=anthropic/claude-haiku-4-5

# --- Optional ---

# Where Claude Code stores transcripts (default: ~/.claude).
# CLAUDE_CONFIG_DIR=

# Judge output cache (default: ~/.cache/tracelens).
# TRACELENS_CACHE_DIR=

# Seconds before giving up on the LLM. The LiteLLM proxy is VPN-only; without
# VPN calls hang ~16s, so keep this short enough that the UI stays responsive.
# TRACELENS_LLM_TIMEOUT=20
