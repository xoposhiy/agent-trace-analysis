# Claude Split Advisor — configuration template.
# Copy this to `.env` (which is git-ignored) and fill in your values:
#     cp .env.example .env
#
# The LLM features (task forest + task summaries) use any OpenAI-compatible
# endpoint. With no key set, the tool still runs fully offline (structural only).
# NOTE: a real environment variable already exported in your shell wins over this
# file, so `.env` is a convenience, not an override.

# --- LLM provider (for the task-forest judge + summaries) ---

# API key for any OpenAI-compatible provider (OpenAI, OpenRouter, a LiteLLM proxy…).
OPENAI_API_KEY=

# Endpoint. Leave unset for OpenAI itself; set it for a proxy / other provider.
# OPENAI_BASE_URL=https://your-endpoint/v1

# Model name your endpoint exposes (default: gpt-4o-mini).
# SPLIT_ADVISOR_MODEL=anthropic/claude-haiku-4-5

# --- Optional ---

# Where Claude Code stores transcripts (default: ~/.claude).
# CLAUDE_CONFIG_DIR=
